{
  "name": "zycount",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @zycount/db prisma:generate",
    "db:migrate": "pnpm --filter @zycount/db prisma:migrate",
    "db:deploy": "pnpm --filter @zycount/db prisma:deploy",
    "db:seed": "pnpm --filter @zycount/db seed",
    "db:reset": "pnpm --filter @zycount/db prisma:reset",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  }
}
