# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://zycount:zycount@localhost:5432/zycount?schema=public"

# ── Redis (cache + BullMQ job queue) ─────────────────────
REDIS_URL="redis://localhost:6379"

# ── Object storage (S3-compatible / MinIO locally) ───────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="zycount-documents"
S3_ACCESS_KEY="zycount"
S3_SECRET_KEY="zycount-secret"

# ── API ──────────────────────────────────────────────────
API_PORT=4000
NODE_ENV="development"

# ── Auth ─────────────────────────────────────────────────
# Generate strong secrets before any real use.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Rate limiting ────────────────────────────────────────
# Requests per window per address, and sign-in attempts per minute.
RATE_LIMIT_MAX=300
RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT=10

# ── Web ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
